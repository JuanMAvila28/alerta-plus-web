# Copy to .env.development.local (development) or .env.production.local.
# OAuth Client ID from Google Cloud ("Web application"). Not secret.
VITE_GOOGLE_CLIENT_ID=REPLACE_WITH_GOOGLE_CLIENT_ID.apps.googleusercontent.com
# Development only: Google posts the login straight to the Worker. In production leave it empty (same origin).
VITE_GOOGLE_LOGIN_URI=http://localhost:8787/api/auth/google
